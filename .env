# .env - Development environment variables for Docker Compose and the GLMS apps
# IMPORTANT: Add this file to .gitignore to avoid committing secrets to version control.
# For production, use Docker secrets or an external secret manager instead of .env.

# Postgre/SQL Server (SQL Server) credentials
MSSQL_SA_PASSWORD=Your_strong_P@ssw0rd
MSSQL_DB=GLMSDb

# Docker/ASP.NET Core settings
ASPNETCORE_ENVIRONMENT=Development
BACKEND_HTTP_PORT=8080
FRONTEND_HTTP_PORT=8082

# Connection string override used by the backend container
# Uses the service name `sql-server-db` on the docker network. The MSSQL_SA_PASSWORD and MSSQL_DB from above will be substituted by docker-compose.
ConnectionStrings__DefaultConnection=Server=sql-server-db,1433;Database=${MSSQL_DB};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT settings for the API (replace with a secure key for real deployments)
Jwt__Key=ChangeMe_ReplaceWithASecretKeyOfAtLeast32Chars!
Jwt__Issuer=glms
Jwt__Audience=glms_users

# App-specific dev values (optional)
Admin__Email=admin@example.com
Admin__Password=AdminP@ssw0rd!

# Notes:
# - This single root .env is convenient for docker-compose and shared secrets.
# - For larger projects or stricter isolation, use per-project .env files (e.g. .env.backend, .env.frontend) or Docker secrets.
# - Never commit production secrets. Use a secrets manager for production.
