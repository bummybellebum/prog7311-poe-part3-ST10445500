@model GLMS.Web.ViewModels.ServiceRequests.ServiceRequestFilterViewModel
@{
    ViewData["Title"] = "Service Requests";
    var canCreateRequests = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.LogisticsManager);
    var canEditRequests = User.IsInRole(ApplicationRoles.Admin);
    var canDeleteRequests = User.IsInRole(ApplicationRoles.Admin);
}

<div class="content-header">
    <div>
        <h1 class="h3 mb-1">Service Requests</h1>
        <p class="text-muted mb-0">Track service request activity and currency-converted values.</p>
    </div>
    <div class="content-header-actions">
        @if (canCreateRequests)
        {
            <a asp-action="Create" class="btn btn-primary">Create Request</a>
        }
    </div>
</div>

@if (Model.ContractId.HasValue || Model.StatusId.HasValue)
{
    <div class="small text-muted mb-2">Showing filtered results.</div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="data-panel filter-panel mb-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="ContractId" class="form-label">Contract</label>
                <select asp-for="ContractId" asp-items="Model.ContractOptions" class="form-select">
                    <option value="">All contracts</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="StatusId" class="form-label">Status</label>
                <select asp-for="StatusId" asp-items="Model.StatusOptions" class="form-select">
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
</section>

<section class="data-panel">
        @if (!Model.Requests.Any())
        {
            <div class="empty-state">No service requests found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Contract</th>
                            <th>Status</th>
                            <th>Original Amount</th>
                            <th>ZAR Amount</th>
                            <th>Requested Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.Requests)
                        {
                            <tr>
                                <td>@req.ContractTitle</td>
                                <td>@await Html.PartialAsync("_StatusBadge", req.ServiceRequestStatusName)</td>
                                <td>@req.AmountOriginal.ToString("N2") @req.OriginalCurrencyCode</td>
                                <td>@req.AmountZAR.ToString("N2")</td>
                                <td>@req.RequestedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    @if (canCreateRequests)
                                    {
                                        <a asp-action="Create" asp-route-contractId="@req.ContractId" class="btn btn-sm btn-success">+ Similar</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@req.ServiceRequestId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (canEditRequests)
                                    {
                                        <a asp-action="Edit" asp-route-id="@req.ServiceRequestId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    }
                                    @if (canDeleteRequests)
                                    {
                                        <a asp-action="Delete" asp-route-id="@req.ServiceRequestId" class="btn btn-sm btn-outline-danger">Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</section>
