@model GLMS.Web.ViewModels.ServiceRequests.ServiceRequestDeleteViewModel
@{
    ViewData["Title"] = "Delete Service Request";
}

<div class="mb-3">
    <h1 class="h3 mb-1 text-danger">Delete Service Request</h1>
    <p class="text-muted mb-0">Confirm deletion of this service request.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning mb-3">
            You are about to delete service request <strong>#@Model.ServiceRequestId</strong>. This action cannot be undone.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Contract</dt>
            <dd class="col-sm-9">@Model.ContractTitle</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@await Html.PartialAsync("_StatusBadge", Model.ServiceRequestStatusName)</dd>

            <dt class="col-sm-3">ZAR Amount</dt>
            <dd class="col-sm-9">@Model.AmountZAR.ToString("N2")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2" onsubmit="return confirm('Delete this service request?');">
            <input type="hidden" asp-for="ServiceRequestId" />
            <button type="submit" class="btn btn-danger">Delete Request</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
