@model GLMS.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var isContractManager = User.IsInRole(ApplicationRoles.ContractManager);
    var isLogisticsManager = User.IsInRole(ApplicationRoles.LogisticsManager);
    var canManageContracts = isAdmin || isContractManager;
    var canCreateRequests = isAdmin || isLogisticsManager;
}

@if (ViewData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="dashboard-grid">
    <section class="dashboard-metrics" aria-label="Dashboard metrics">
        <article class="dashboard-card metric-card">
            <span class="metric-icon teal" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M16.5 20v-1.8c0-2.1-1.8-3.7-4.5-3.7s-4.5 1.6-4.5 3.7V20" /><path d="M12 12.2a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" /><path d="M4.5 18.5v-1.1c0-1.3.8-2.4 2.1-3" /><path d="M17.4 14.4c1.3.6 2.1 1.7 2.1 3v1.1" /></svg>
            </span>
            <span class="metric-copy">
                <span class="metric-label">Clients</span>
                <span class="metric-value">@Model.TotalClients</span>
                <span class="metric-subtitle">Active</span>
            </span>
        </article>

        <article class="dashboard-card metric-card">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3.8h7.2L18 7.6V20H7V3.8Z" /><path d="M14 4v4h4" /><path d="M9.5 11h5" /><path d="M9.5 14h5" /><path d="M9.5 17h3" /></svg>
            </span>
            <span class="metric-copy">
                <span class="metric-label">Contracts</span>
                <span class="metric-value">@Model.ActiveContracts</span>
                <span class="metric-subtitle">Active</span>
            </span>
        </article>

        <article class="dashboard-card metric-card">
            <span class="metric-icon teal" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 7.5h10v8H5z" /><path d="M15 10h3.2l1.8 2.4v3.1h-5" /><path d="M7.4 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /><path d="M17.7 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /></svg>
            </span>
            <span class="metric-copy">
                <span class="metric-label">Service Requests</span>
                <span class="metric-value">@Model.TotalServiceRequests</span>
                <span class="metric-subtitle">Open</span>
            </span>
        </article>

        <article class="dashboard-card metric-card">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /><circle cx="12" cy="12" r="9" /></svg>
            </span>
            <span class="metric-copy">
                <span class="metric-label">Requests Completed</span>
                <span class="metric-value">@Model.CompletedServiceRequests</span>
                <span class="metric-subtitle">This Month</span>
            </span>
        </article>
    </section>

    <section class="dashboard-main">
        <section class="data-panel dashboard-table-panel">
            <div class="panel-header dashboard-panel-header">
                <div>
                    <h2 class="h5">Recent Service Requests</h2>
                </div>
                <a asp-controller="ServiceRequests" asp-action="Index" class="dashboard-view-link">View all</a>
            </div>

            @if (!Model.RecentServiceRequests.Any())
            {
                <div class="empty-state">No recent service requests available.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 dashboard-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Contract</th>
                                <th>Status</th>
                                <th>Created On</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentServiceRequests)
                            {
                                <tr>
                                    <td class="fw-semibold">SR-@item.ServiceRequestId.ToString("D4")</td>
                                    <td>@item.ContractTitle</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", item.StatusName)</td>
                                    <td>@item.RequestedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@item.ServiceRequestId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="data-panel workflow-panel">
            <div class="panel-header dashboard-panel-header">
                <h2 class="h5">Role Workflow</h2>
            </div>
            <div class="workflow-strip">
                @if (isAdmin)
                {
                    <a asp-controller="AdminUsers" asp-action="Create" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8.5 11.8a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" /><path d="M3.8 19.5v-1.2c0-2 1.9-3.6 4.7-3.6s4.7 1.6 4.7 3.6v1.2" /><path d="M16 8h4" /><path d="M18 6v4" /></svg></span>
                        <span><strong>Create User</strong><small>Invite and assign access</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="Clients" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 5h12v14H6z" /><path d="M9 9h6" /><path d="M9 13h6" /></svg></span>
                        <span><strong>Review</strong><small>Check records and statuses</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14" /><path d="M5 12h14" /><circle cx="12" cy="12" r="8" /></svg></span>
                        <span><strong>Coordinate</strong><small>Align contracts and requests</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /><circle cx="12" cy="12" r="9" /></svg></span>
                        <span><strong>Complete</strong><small>Close operational work</small></span>
                    </a>
                }
                else if (isContractManager)
                {
                    <a asp-controller="Clients" asp-action="Create" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16.5 20v-1.8c0-2.1-1.8-3.7-4.5-3.7s-4.5 1.6-4.5 3.7V20" /><path d="M12 12.2a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" /></svg></span>
                        <span><strong>Add Client</strong><small>Capture client details</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="Contracts" asp-action="Create" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.8h7.2L18 7.6V20H7V3.8Z" /><path d="M14 4v4h4" /><path d="M9.5 12h5" /></svg></span>
                        <span><strong>Create Contract</strong><small>Attach agreement terms</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 5h12v14H6z" /><path d="M9 9h6" /><path d="M9 13h6" /></svg></span>
                        <span><strong>Review</strong><small>Validate contract status</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /><circle cx="12" cy="12" r="9" /></svg></span>
                        <span><strong>Activate</strong><small>Ready for requests</small></span>
                    </a>
                }
                else
                {
                    <a asp-controller="ServiceRequests" asp-action="Create" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7.5h10v8H5z" /><path d="M15 10h3.2l1.8 2.4v3.1h-5" /></svg></span>
                        <span><strong>Create Request</strong><small>Submit freight or service need</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 5h12v14H6z" /><path d="M9 9h6" /><path d="M9 13h6" /></svg></span>
                        <span><strong>Review</strong><small>Operations review and assign</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14" /><path d="M5 12h14" /><circle cx="12" cy="12" r="8" /></svg></span>
                        <span><strong>Execute</strong><small>Coordinate and update</small></span>
                    </a>
                    <span class="workflow-arrow" aria-hidden="true">></span>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-step">
                        <span class="workflow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-8" /><circle cx="12" cy="12" r="9" /></svg></span>
                        <span><strong>Complete</strong><small>Confirm delivery and close</small></span>
                    </a>
                }
            </div>
        </section>
    </section>

    <aside class="dashboard-rail" aria-label="Dashboard actions and status">
        <section class="data-panel dashboard-actions-panel">
            @if (canCreateRequests)
            {
                <a class="dashboard-action primary" asp-controller="ServiceRequests" asp-action="Create">
                    <span aria-hidden="true">+</span>
                    Create Request
                </a>
            }
            @if (canManageContracts)
            {
                <a class="dashboard-action" asp-controller="Clients" asp-action="Create">
                    <span aria-hidden="true">+</span>
                    Add Client
                </a>
                <a class="dashboard-action outline" asp-controller="Contracts" asp-action="Create">
                    <span aria-hidden="true">+</span>
                    New Contract
                </a>
            }
        </section>

        <section class="data-panel dashboard-status-panel">
            <div class="panel-header dashboard-panel-header">
                <h2 class="h5">Status Legend</h2>
            </div>
            <div class="dashboard-status-list">
                @await Html.PartialAsync("_StatusBadge", "New")
                @await Html.PartialAsync("_StatusBadge", "In Progress")
                @await Html.PartialAsync("_StatusBadge", "On Hold")
                @await Html.PartialAsync("_StatusBadge", "Completed")
                @await Html.PartialAsync("_StatusBadge", "Cancelled")
            </div>
        </section>
    </aside>
</div>
