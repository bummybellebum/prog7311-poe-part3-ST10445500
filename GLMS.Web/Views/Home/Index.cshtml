@model GLMS.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var isContractManager = User.IsInRole(ApplicationRoles.ContractManager);
    var isLogisticsManager = User.IsInRole(ApplicationRoles.LogisticsManager);
}

<div class="dashboard-hero mb-4">
    <div>
        <h1 class="h2 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">
            @if (isAdmin)
            {
                <span>System overview for clients, contracts, users, and logistics requests.</span>
            }
            else if (isContractManager)
            {
                <span>Contract management overview for clients, agreements, and contract statuses.</span>
            }
            else
            {
                <span>Logistics overview for active contracts and service request processing.</span>
            }
        </p>
    </div>
</div>

@if (ViewData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-6 col-xl-3">
        <div class="dashboard-card">
            <span class="metric-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M16.5 20v-1.8c0-2.1-1.8-3.7-4.5-3.7s-4.5 1.6-4.5 3.7V20" /><path d="M12 12.2a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" /><path d="M4.5 18.5v-1.1c0-1.3.8-2.4 2.1-3" /><path d="M17.4 14.4c1.3.6 2.1 1.7 2.1 3v1.1" /></svg>
            </span>
            <div class="metric-label">Clients</div>
            <div class="metric-value">@Model.TotalClients</div>
            <a asp-controller="Clients" asp-action="Index" class="metric-link">View all clients</a>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl-3">
        <div class="dashboard-card">
            <span class="metric-icon teal" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3.8h7.2L18 7.6V20H7V3.8Z" /><path d="M14 4v4h4" /><path d="M9.5 11h5" /><path d="M9.5 14h5" /><path d="M9.5 17h3" /></svg>
            </span>
            <div class="metric-label">Active Contracts</div>
            <div class="metric-value">@Model.ActiveContracts</div>
            <a asp-controller="Contracts" asp-action="Index" class="metric-link">View contracts</a>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl-3">
        <div class="dashboard-card">
            <span class="metric-icon warn" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 7.5h10v8H5z" /><path d="M15 10h3.2l1.8 2.4v3.1h-5" /><path d="M7.4 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /><path d="M17.7 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /></svg>
            </span>
            <div class="metric-label">Pending Requests</div>
            <div class="metric-value">@Model.PendingServiceRequests</div>
            <a asp-controller="ServiceRequests" asp-action="Index" class="metric-link">View requests</a>
        </div>
    </div>
    <div class="col-6 col-md-6 col-xl-3">
        <div class="dashboard-card">
            <span class="metric-icon danger" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 8v5" /><path d="M12 17h.1" /><path d="m4 20 8-16 8 16H4Z" /></svg>
            </span>
            <div class="metric-label">Expired / On Hold</div>
            <div class="metric-value">@Model.ExpiredOrOnHoldContracts</div>
            <a asp-controller="Contracts" asp-action="Index" class="metric-link">Review statuses</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <section class="data-panel h-100">
            <div class="panel-header">
                <div>
                    <h2 class="h5">Recent Service Requests</h2>
                    <p class="panel-subtitle">Latest operational activity across active contracts.</p>
                </div>
                <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>

            @if (!Model.RecentServiceRequests.Any())
            {
                <div class="empty-state">No recent service requests available.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Request</th>
                                <th>Contract</th>
                                <th>Status</th>
                                <th>Requested</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentServiceRequests)
                            {
                                <tr>
                                    <td class="fw-semibold">SR-@item.ServiceRequestId.ToString("D4")</td>
                                    <td>@item.ContractTitle</td>
                                    <td>@await Html.PartialAsync("_StatusBadge", item.StatusName)</td>
                                    <td>@item.RequestedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">
                                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@item.ServiceRequestId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-xl-4">
        <section class="data-panel h-100">
            <div class="panel-header">
                <div>
                    <h2 class="h5">Role Workflow</h2>
                    <p class="panel-subtitle">Common actions for your current role.</p>
                </div>
            </div>
            <div class="workflow-list">
                @if (isAdmin)
                {
                    <a asp-controller="AdminUsers" asp-action="Index" class="workflow-action">Manage Users</a>
                    <a asp-controller="Clients" asp-action="Index" class="workflow-action">Review Clients</a>
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-action">Review Contracts</a>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-action">Review Service Requests</a>
                }
                else if (isContractManager)
                {
                    <a asp-controller="Clients" asp-action="Index" class="workflow-action">Manage Clients</a>
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-action">Manage Contracts</a>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-action">View Service Requests</a>
                }
                else
                {
                    <a asp-controller="Contracts" asp-action="Index" class="workflow-action">Find Active Contracts</a>
                    <a asp-controller="ServiceRequests" asp-action="Create" class="workflow-action">Create Service Request</a>
                    <a asp-controller="ServiceRequests" asp-action="Index" class="workflow-action">Update Request Status</a>
                }
            </div>
        </section>
    </div>
</div>

<section class="data-panel">
    <div class="panel-header">
        <div>
            <h2 class="h6">Status Legend</h2>
            <p class="panel-subtitle">Shared statuses used across contracts and service requests.</p>
        </div>
    </div>
    <div class="p-3 status-legend">
        @await Html.PartialAsync("_StatusBadge", "Draft")
        @await Html.PartialAsync("_StatusBadge", "Active")
        @await Html.PartialAsync("_StatusBadge", "On Hold")
        @await Html.PartialAsync("_StatusBadge", "Expired")
        @await Html.PartialAsync("_StatusBadge", "Pending")
        @await Html.PartialAsync("_StatusBadge", "Approved")
        @await Html.PartialAsync("_StatusBadge", "In Progress")
        @await Html.PartialAsync("_StatusBadge", "Completed")
        @await Html.PartialAsync("_StatusBadge", "Cancelled")
    </div>
</section>
