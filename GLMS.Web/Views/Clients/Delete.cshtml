@model GLMS.Web.ViewModels.Api.ClientDetailDto
@{
    ViewData["Title"] = "Delete Client";
}

<div class="mb-3">
    <h1 class="h3 mb-1 text-danger">Delete Client</h1>
    <p class="text-muted mb-0">Confirm removal of this client record.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning mb-3">
            You are about to delete <strong>@Model.CompanyName</strong>. This action cannot be undone.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.CompanyName</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@await Html.PartialAsync("_StatusBadge", Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2" onsubmit="return confirm('Delete this client?');">
            <input type="hidden" asp-for="ClientId" />
            <button type="submit" class="btn btn-danger">Delete Client</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
