@model List<GLMS.Web.Models.Client>
@{
    ViewData["Title"] = "Clients";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Clients</h1>
        <p class="text-muted mb-0">Manage client organizations and account details.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Client</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by company name or email" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">No clients found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Region</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CompanyName</td>
                                <td>@item.Email</td>
                                <td>@(item.Region ?? "-")</td>
                                <td>@(item.Country ?? "-")</td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", item.IsActive ? "Active" : "Inactive")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
