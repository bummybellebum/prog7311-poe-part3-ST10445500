@model List<GLMS.Web.ViewModels.Api.ClientListDto>
@{
    ViewData["Title"] = "Clients";
    var search = ViewData["Search"] as string;
    var canManageClients = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ContractManager);
    var canDeleteClients = User.IsInRole(ApplicationRoles.Admin);
}

<div class="content-header">
    <div>
        <h1 class="h3 mb-1">Clients</h1>
        <p class="text-muted mb-0">Manage client organizations and account details.</p>
    </div>
    <div class="content-header-actions">
        @if (canManageClients)
        {
            <a asp-action="Create" class="btn btn-primary">Add Client</a>
        }
    </div>
</div>

@if (ViewData["ErrorMessage"] is string viewErrorMessage)
{
    <div class="alert alert-danger">@viewErrorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="data-panel filter-panel mb-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="client-search" class="form-label">Search</label>
                <input id="client-search" type="text" name="search" value="@search" class="form-control" placeholder="Search by company name or email" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
</section>

<section class="data-panel">
        @if (!Model.Any())
        {
            <div class="empty-state">No clients found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Region</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CompanyName</td>
                                <td>@item.Email</td>
                                <td>@(item.Region ?? "-")</td>
                                <td>@(item.Country ?? "-")</td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", item.IsActive ? "Active" : "Inactive")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (canManageClients)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    }
                                    @if (canDeleteClients)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-danger">Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</section>
