@model GLMS.Web.ViewModels.Account.AdminUserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Edit User</h1>
    <p class="text-muted mb-0">Update user access and account status.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.UserId" method="post" novalidate>
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select"></select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save User</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h5 mb-3">Reset Password</h2>
                <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post" novalidate>
                    <input type="hidden" name="UserId" value="@Model.UserId" />
                    <div class="mb-3">
                        <label for="TemporaryPassword" class="form-label">Temporary password</label>
                        <input id="TemporaryPassword" name="TemporaryPassword" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label for="ConfirmTemporaryPassword" class="form-label">Confirm temporary password</label>
                        <input id="ConfirmTemporaryPassword" name="ConfirmTemporaryPassword" type="password" class="form-control" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-outline-primary w-100">Set Temporary Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
