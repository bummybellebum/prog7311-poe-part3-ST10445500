@model GLMS.Web.ViewModels.Account.AdminUserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Create User</h1>
    <p class="text-muted mb-0">Create an internal GLMS account.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select"></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TemporaryPassword" class="form-label"></label>
                    <input asp-for="TemporaryPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="TemporaryPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmTemporaryPassword" class="form-label"></label>
                    <input asp-for="ConfirmTemporaryPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmTemporaryPassword" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save User</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
