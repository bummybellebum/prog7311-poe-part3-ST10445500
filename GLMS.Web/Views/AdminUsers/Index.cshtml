@model IReadOnlyList<GLMS.Web.ViewModels.Account.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Users</h1>
        <p class="text-muted mb-0">Manage GLMS user accounts and role access.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add User</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">No users found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.DisplayName</td>
                                <td>@item.Email</td>
                                <td>@item.Role</td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", item.IsActive ? "Active" : "Inactive")
                                </td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@item.UserId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.UserId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
