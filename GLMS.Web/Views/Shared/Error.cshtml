@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="data-panel">
    <div class="p-5 text-center">
        <div class="metric-icon danger mx-auto">ER</div>
        <h1 class="h3 mb-2">Something went wrong</h1>
        <p class="text-muted mb-4">GLMS could not complete the request. Please try again or return to the dashboard.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
    </div>
</section>
