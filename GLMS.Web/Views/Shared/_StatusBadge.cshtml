@model string
@{
    var status = (Model ?? string.Empty).Trim();
    var badgeClass = status.ToLowerInvariant() switch
    {
        "active" => "status-success",
        "on hold" => "status-warning",
        "expired" => "status-danger",
        "draft" => "status-muted",
        "pending" => "status-warning",
        "approved" => "status-info",
        "in progress" => "status-primary",
        "completed" => "status-success",
        "cancelled" => "status-danger",
        "inactive" => "status-muted",
        _ => "status-muted"
    };
}
<span class="status-badge @badgeClass">@(string.IsNullOrWhiteSpace(status) ? "Unknown" : status)</span>
