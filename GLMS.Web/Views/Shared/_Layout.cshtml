<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GLMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(ApplicationRoles.Admin);
    var isContractManager = User.IsInRole(ApplicationRoles.ContractManager);
    var isLogisticsManager = User.IsInRole(ApplicationRoles.LogisticsManager);
    var canManageContracts = isAdmin || isContractManager;
    var canCreateRequests = isAdmin || isLogisticsManager;
    var roleName = isAdmin ? ApplicationRoles.Admin : isContractManager ? ApplicationRoles.ContractManager : isLogisticsManager ? ApplicationRoles.LogisticsManager : "Guest";
    var displayName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Substring(0, 1).ToUpperInvariant();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    string NavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "sidebar-link active" : "sidebar-link";
    string MobileNavClass(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "mobile-nav-link active" : "mobile-nav-link";
}
<body>
    @if (isSignedIn)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <a class="brand-block text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="shell-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 64 64" focusable="false">
                            <circle cx="32" cy="32" r="25" />
                            <path d="M7 32h50" />
                            <path d="M32 7c8 7 12 15 12 25S40 50 32 57" />
                            <path d="M32 7C24 14 20 22 20 32s4 18 12 25" />
                            <path d="M13 20c7 4 14 6 19 6s12-2 19-6" />
                            <path d="M13 44c7-4 14-6 19-6s12 2 19 6" />
                        </svg>
                    </span>
                    <span>
                        <span class="brand-title">GLMS</span>
                    </span>
                </a>

                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5v8a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9V20H5.5A1.5 1.5 0 0 1 4 18.5v-8Z" /></svg>
                        </span>
                        Dashboard
                    </a>
                    <a class="@NavClass("Clients")" asp-controller="Clients" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M16.5 20v-1.8c0-2.1-1.8-3.7-4.5-3.7s-4.5 1.6-4.5 3.7V20" /><path d="M12 12.2a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" /><path d="M4.5 18.5v-1.1c0-1.3.8-2.4 2.1-3" /><path d="M17.4 14.4c1.3.6 2.1 1.7 2.1 3v1.1" /></svg>
                        </span>
                        Clients
                    </a>
                    <a class="@NavClass("Contracts")" asp-controller="Contracts" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M7 3.8h7.2L18 7.6V20H7V3.8Z" /><path d="M14 4v4h4" /><path d="M9.5 11h5" /><path d="M9.5 14h5" /><path d="M9.5 17h3" /></svg>
                        </span>
                        Contracts
                    </a>
                    <a class="@NavClass("ServiceRequests")" asp-controller="ServiceRequests" asp-action="Index">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M5 7.5h10v8H5z" /><path d="M15 10h3.2l1.8 2.4v3.1h-5" /><path d="M7.4 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /><path d="M17.7 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /></svg>
                        </span>
                        Service Requests
                    </a>
                    @if (isAdmin)
                    {
                        <a class="@NavClass("AdminUsers")" asp-controller="AdminUsers" asp-action="Index">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M8.5 11.8a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z" /><path d="M3.8 19.5v-1.2c0-2 1.9-3.6 4.7-3.6s4.7 1.6 4.7 3.6v1.2" /><path d="M16 8h4" /><path d="M18 6v4" /><path d="M15.5 14.2h4.7" /><path d="M15.5 17.2h3.2" /></svg>
                            </span>
                            Users
                        </a>
                    }
                    <a class="@(NavClass("Account")) mt-lg-3" asp-controller="Account" asp-action="Profile">
                        <span class="nav-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 12.2a3.8 3.8 0 1 0 0-7.6 3.8 3.8 0 0 0 0 7.6Z" /><path d="M5.2 20v-1.5c0-2.4 2.7-4.4 6.8-4.4s6.8 2 6.8 4.4V20" /></svg>
                        </span>
                        Profile
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-link sidebar-logout">
                            <span class="nav-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M10 5H6.5A1.5 1.5 0 0 0 5 6.5v11A1.5 1.5 0 0 0 6.5 19H10" /><path d="M14 8l4 4-4 4" /><path d="M18 12H9" /></svg>
                            </span>
                            Logout
                        </button>
                    </form>
                </div>
            </aside>

            <div class="app-main">
                <header class="mobile-appbar">
                    <button class="icon-button" type="button" data-mobile-nav-toggle aria-controls="mobileMenu" aria-expanded="false" aria-label="Open navigation">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                    </button>
                    <a class="mobile-brand text-decoration-none" asp-controller="Home" asp-action="Index">
                        <span class="shell-brand-mark shell-brand-mark-sm" aria-hidden="true">
                            <svg viewBox="0 0 64 64" focusable="false">
                                <circle cx="32" cy="32" r="25" />
                                <path d="M7 32h50" />
                                <path d="M32 7c8 7 12 15 12 25S40 50 32 57" />
                                <path d="M32 7C24 14 20 22 20 32s4 18 12 25" />
                                <path d="M13 20c7 4 14 6 19 6s12-2 19-6" />
                                <path d="M13 44c7-4 14-6 19-6s12 2 19 6" />
                            </svg>
                        </span>
                        <span>GLMS</span>
                    </a>
                    <a class="icon-button" asp-controller="Account" asp-action="Profile" aria-label="Profile">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12.2a3.8 3.8 0 1 0 0-7.6 3.8 3.8 0 0 0 0 7.6Z" /><path d="M5.2 20v-1.5c0-2.4 2.7-4.4 6.8-4.4s6.8 2 6.8 4.4V20" /></svg>
                    </a>
                </header>

                <header class="topbar">
                    <div class="topbar-title">
                        <button class="topbar-menu-button" type="button" aria-label="Main menu">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                        </button>
                        <span>@pageTitle</span>
                    </div>
                    <div class="topbar-actions">
                        <a class="account-pill" asp-controller="Account" asp-action="Profile">
                            <span class="account-avatar" aria-hidden="true">@userInitial</span>
                            <span class="account-copy">
                                <span class="account-name">@displayName</span>
                                <span class="account-role">@roleName</span>
                            </span>
                        </a>
                        <form class="topbar-logout-form" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="topbar-logout-button" aria-label="Logout">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H6.5A1.5 1.5 0 0 0 5 6.5v11A1.5 1.5 0 0 0 6.5 19H10" /><path d="M14 8l4 4-4 4" /><path d="M18 12H9" /></svg>
                            </button>
                        </form>
                    </div>
                </header>

                <main role="main" class="app-content">
                    @RenderBody()
                </main>

                <nav class="mobile-bottom-nav" aria-label="Mobile primary navigation">
                    <a class="@MobileNavClass("Home")" asp-controller="Home" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5v8a1.5 1.5 0 0 1-1.5 1.5H15v-5.5H9V20H5.5A1.5 1.5 0 0 1 4 18.5v-8Z" /></svg>
                        Dashboard
                    </a>
                    <a class="@MobileNavClass("Clients")" asp-controller="Clients" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 20v-1.8c0-2.1-1.8-3.7-4.5-3.7s-4.5 1.6-4.5 3.7V20" /><path d="M12 12.2a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2Z" /></svg>
                        Clients
                    </a>
                    <a class="@MobileNavClass("Contracts")" asp-controller="Contracts" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.8h7.2L18 7.6V20H7V3.8Z" /><path d="M14 4v4h4" /><path d="M9.5 12h5" /><path d="M9.5 15h5" /></svg>
                        Contracts
                    </a>
                    <a class="@MobileNavClass("ServiceRequests")" asp-controller="ServiceRequests" asp-action="Index">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7.5h10v8H5z" /><path d="M15 10h3.2l1.8 2.4v3.1h-5" /><path d="M7.4 18.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z" /></svg>
                        Requests
                    </a>
                    <button class="mobile-nav-link" type="button" data-mobile-nav-toggle aria-controls="mobileMenu" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.1M12 12h.1M19 12h.1" /></svg>
                        More
                    </button>
                </nav>
            </div>
        </div>

        <div class="mobile-menu-backdrop" data-mobile-nav-close></div>
        <aside class="mobile-menu" id="mobileMenu" aria-label="Mobile navigation" aria-hidden="true">
            <div class="mobile-menu-header">
                <div class="account-summary">
                    <span class="account-avatar account-avatar-lg" aria-hidden="true">@userInitial</span>
                    <span>
                        <span class="account-summary-name">@displayName</span>
                        <span class="account-summary-role">@roleName</span>
                    </span>
                </div>
                <button class="icon-button icon-button-light" type="button" data-mobile-nav-close aria-label="Close navigation">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <nav class="mobile-menu-nav" aria-label="Mobile menu links">
                <a class="@MobileNavClass("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="@MobileNavClass("Clients")" asp-controller="Clients" asp-action="Index">Clients</a>
                <a class="@MobileNavClass("Contracts")" asp-controller="Contracts" asp-action="Index">Contracts</a>
                <a class="@MobileNavClass("ServiceRequests")" asp-controller="ServiceRequests" asp-action="Index">Service Requests</a>
                @if (isAdmin)
                {
                    <a class="@MobileNavClass("AdminUsers")" asp-controller="AdminUsers" asp-action="Index">Users</a>
                }
                <a class="@MobileNavClass("Account")" asp-controller="Account" asp-action="Profile">Profile</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="mobile-menu-logout">Logout</button>
                </form>
            </nav>
        </aside>
    }
    else
    {
        <main role="main" class="auth-shell">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
