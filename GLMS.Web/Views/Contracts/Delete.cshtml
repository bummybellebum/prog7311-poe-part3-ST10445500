@model GLMS.Web.ViewModels.Contracts.ContractDeleteViewModel
@{
    ViewData["Title"] = "Delete Contract";
}

<div class="mb-3">
    <h1 class="h3 mb-1 text-danger">Delete Contract</h1>
    <p class="text-muted mb-0">Confirm deletion of this contract record.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning mb-3">
            You are about to delete contract <strong>@Model.Title</strong>. This action cannot be undone.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Client</dt>
            <dd class="col-sm-9">@Model.ClientName</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@await Html.PartialAsync("_StatusBadge", Model.ContractStatusName)</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2" onsubmit="return confirm('Delete this contract?');">
            <input type="hidden" asp-for="ContractId" />
            <button type="submit" class="btn btn-danger">Delete Contract</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
