@model GLMS.Web.ViewModels.Contracts.ContractFilterViewModel
@{
    ViewData["Title"] = "Contracts";
    var canManageContracts = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.ContractManager);
    var canCreateRequests = User.IsInRole(ApplicationRoles.Admin) || User.IsInRole(ApplicationRoles.LogisticsManager);
    var canDeleteContracts = User.IsInRole(ApplicationRoles.Admin);
}

<div class="content-header">
    <div>
        <h1 class="h3 mb-1">Contracts</h1>
        <p class="text-muted mb-0">Search and manage contract lifecycle records.</p>
    </div>
    <div class="content-header-actions">
        @if (canManageContracts)
        {
            <a asp-action="Create" class="btn btn-primary">Add Contract</a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<section class="data-panel filter-panel mb-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="StatusId" class="form-label">Status</label>
                <select asp-for="StatusId" asp-items="Model.StatusOptions" class="form-select">
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="ClientId" class="form-label">Client</label>
                <select asp-for="ClientId" asp-items="Model.ClientOptions" class="form-select">
                    <option value="">All clients</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="StartDate" class="form-label">Start Date</label>
                <input asp-for="StartDate" class="form-control" type="date" />
            </div>
            <div class="col-md-2">
                <label asp-for="EndDate" class="form-label">End Date</label>
                <input asp-for="EndDate" class="form-control" type="date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
</section>

<section class="data-panel">
        @if (!Model.Contracts.Any())
        {
            <div class="empty-state">No contracts match the selected filters.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Client</th>
                            <th>Status</th>
                            <th>Start</th>
                            <th>End</th>
                            <th class="text-center">Service Requests</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model.Contracts)
                        {
                            <tr>
                                <td>@contract.Title</td>
                                <td>@contract.ClientName</td>
                                <td>@await Html.PartialAsync("_StatusBadge", contract.ContractStatusName)</td>
                                <td>@contract.StartDate.ToString("yyyy-MM-dd")</td>
                                <td>@contract.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-center">
                                    <a asp-controller="ServiceRequests" asp-action="Index" asp-route-contractId="@contract.ContractId" class="btn btn-sm btn-outline-secondary">View</a>
                                </td>
                                <td class="text-end">
                                    @if (canCreateRequests && string.Equals(contract.ContractStatusName, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@contract.ContractId" class="btn btn-sm btn-success">+ Request</a>
                                    }
                                    <a asp-action="Details" asp-route-id="@contract.ContractId" class="btn btn-sm btn-outline-secondary">Details</a>
                                    @if (canManageContracts)
                                    {
                                        <a asp-action="Edit" asp-route-id="@contract.ContractId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    }
                                    @if (canDeleteContracts)
                                    {
                                        <a asp-action="Delete" asp-route-id="@contract.ContractId" class="btn btn-sm btn-outline-danger">Delete</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
</section>
