@model GLMS.Models.ServiceRequest
@{
    ViewData["Title"] = "Service Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Service Request #@Model.ServiceRequestId</h1>
        <p class="text-muted mb-0">Service request details and converted values.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ServiceRequestId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><strong>Contract:</strong> @(Model.Contract?.Title ?? "-")</div>
            <div class="col-md-4"><strong>Status:</strong> @await Html.PartialAsync("_StatusBadge", Model.ServiceRequestStatus?.StatusName ?? "Unknown")</div>
            <div class="col-md-4"><strong>Requested:</strong> @Model.RequestedAt.ToString("yyyy-MM-dd HH:mm")</div>
            <div class="col-md-4"><strong>Original Amount:</strong> @Model.AmountOriginal.ToString("N2") @Model.OriginalCurrencyCode</div>
            <div class="col-md-4"><strong>Rate to ZAR:</strong> @Model.ExchangeRateToZAR.ToString("N6")</div>
            <div class="col-md-4"><strong>ZAR Amount:</strong> @Model.AmountZAR.ToString("N2")</div>
            <div class="col-12">
                <strong>Description</strong>
                <p class="mb-0 mt-1 text-muted">@Model.Description</p>
            </div>
        </div>
    </div>
</div>
